# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials).
# Enable the "YouTube Data API v3" on the project the key belongs to.
YOUTUBE_API_KEY=

# The playlist that is the source of truth for the podcast page's episode
# list (e.g. Natalie's "Sugar Spice & Spirits" uploads playlist).
# Find it in the playlist's URL: https://www.youtube.com/playlist?list=PLxxxxxxxx
#                                                                      ^ this part
YOUTUBE_PLAYLIST_ID=

# Secondary lead webhook (n8n). The site sends leads to GoHighLevel first.
# This webhook still receives the same JSON, plus phone, interest, source, and
# optional note or address. If GoHighLevel is down, a successful webhook still
# counts as a captured lead. See automation/n8n/buyer-checklist-lead-capture.json.
LEAD_CAPTURE_WEBHOOK_URL=

# GoHighLevel, white-labeled as Close Control. Private integration token from
# the sub-account (Settings, Private Integrations). The token needs contacts
# write, opportunities write, and opportunities read so the site can list pipelines.
# Do not commit the token. On Vercel, store it as a sensitive environment variable.
GHL_PRIVATE_TOKEN=

# Sub-account location id from Settings, Business Profile.
GHL_LOCATION_ID=

# Optional JSON map from lead type to a pipeline id or the pipeline's exact name.
# Keys: buyer, seller, investor, agent, podcast-guest, general, default.
# Names are matched case-insensitively. Unmapped types are matched by keywords
# (buyer, seller, investor, agent/recruit, podcast), then general/default, then
# the first pipeline returned.
# Example: {"buyer":"Buyers","seller":"Sellers","agent":"Agent Recruits","default":"General"}
# GHL_PIPELINE_MAP=

# Vercel AI Gateway for the site chat. On Vercel, enable AI Gateway for the project.
# Deployments authenticate with the automatic VERCEL_OIDC_TOKEN. Do not add an
# OpenAI, Anthropic, or Google key. For local chat, run `vercel env pull` after
# `vercel link`, or set AI_GATEWAY_API_KEY from the AI Gateway dashboard.
# Optional model override. Default is google/gemini-3-flash.
# AI_GATEWAY_MODEL=
